# --- App ---
PORT=3000

# --- Infrastructure ---
# Used for local runs (`pnpm start:dev`). docker-compose overrides both with
# the in-network hostnames (postgres / redis).
DATABASE_URL=postgresql://goodeva:goodeva@localhost:5432/goodevadesk?schema=public
REDIS_URL=redis://localhost:6379

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=2000
LLM_TEMPERATURE=0.2

# --- Embeddings & semantic cache ---
# Any transformers.js feature-extraction model works; the vector dimension is
# detected at runtime. English-only alternative: Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./.models
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_TTL_SECONDS=604800

# --- Queue ---
TRIAGE_CONCURRENCY=2

# --- Seed (demo organizations: Acme Corp, Globex Inc) ---
# Comma-separated plaintext keys; leave empty to generate and print new ones.
SEED_ORG_API_KEYS=acme-demo-key,globex-demo-key
